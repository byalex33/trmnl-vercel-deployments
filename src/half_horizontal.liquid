
<div class="layout layout--col gap--xsmall">
  {% for d in deployments limit:3 %}
    <div class="item">
      <div class="content">
        <span class="title title--small">{{ d.name }} · {{ d.state }}</span>
        <span class="label label--small">{{ d.target }} · {{ d.age }} · {{ d.branch }}</span>
      </div>
    </div>
  {% endfor %}
</div>
<div class="title_bar">
  <span class="title">Vercel</span>
</div>
